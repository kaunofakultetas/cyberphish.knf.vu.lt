# -----------------------------------------------------------
#  [*] my.cnf — the test container's MySQL server
#
#  MySQL 5.7.42 on its stock settings — the character set,
#  the collations and the SQL mode the production server
#  runs with stay untouched — moved onto the container's
#  tmpfs mounts and tuned for a database that lives for one
#  run: small log files, no flush on every commit, no
#  doublewrite buffer, no performance schema. It listens on
#  127.0.0.1 only; the container has no other network.
#  run.sh passes it with --defaults-file, so no other
#  option file is read.
# -----------------------------------------------------------

[mysqld]
datadir                        = /var/lib/mysql
socket                         = /run/mysqld/mysqld.sock
pid-file                       = /run/mysqld/mysqld.pid
log-error                      = /var/www/logs/mysql.err
bind-address                   = 127.0.0.1
port                           = 3306
skip-name-resolve
secure-file-priv               = NULL
innodb_buffer_pool_size        = 64M
innodb_log_file_size           = 8M
innodb_flush_log_at_trx_commit = 0
skip-innodb-doublewrite
performance_schema             = OFF

[client]
socket                         = /run/mysqld/mysqld.sock
