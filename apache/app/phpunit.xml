<?xml version="1.0" encoding="UTF-8"?>
<!--
  The regression suite of the Apache app, run by ../runTests.sh inside
  the test container (tests/README.md). Three suites, cheapest first:
  Platform checks the image as shipped, Feature drives the app in-process
  with every test inside a rolled-back transaction, and Apache talks to
  the real Apache over HTTP. The server values switch the in-process app
  to its testing setup; Apache keeps the production environment run.sh
  gives it. displayDetailsOnIncompleteTests lists every pinned known defect
  after a run.
-->
<phpunit bootstrap="tests/bootstrap.php"
         colors="true"
         displayDetailsOnIncompleteTests="true"
         recordTestRunHistory="false"
         beStrictAboutOutputDuringTests="true"
>
    <testsuites>
        <testsuite name="Platform">
            <directory suffix="Test.php">./tests/Platform</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
        <testsuite name="Apache">
            <directory suffix="Test.php">./tests/Apache</directory>
        </testsuite>
    </testsuites>
    <php>
        <server name="APP_ENV" value="testing"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="CACHE_DRIVER" value="array"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
    </php>
</phpunit>
